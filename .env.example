# Copy to .env for local development. Never commit real credentials.
MERCURY_ENV=local
MERCURY_LOG_LEVEL=INFO
MERCURY_MODEL_VERSION=unconfigured
MERCURY_REDIS_URL=redis://redis:6379/0
MERCURY_MLFLOW_TRACKING_URI=http://mlflow:5000
MERCURY_POSTGRES_DSN=postgresql://mercury:mercury@postgres:5432/mercury
